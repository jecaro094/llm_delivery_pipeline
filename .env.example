# Environment variables recognized by model_pipeline (see PLAN.md, section 7).
# Copy this file to `.env` and fill in real values for local execution.
# `.env` itself is gitignored and must never be committed.

# --- Secrets ---

# Hugging Face token with write access. Only needed by `produce`, to publish
# the encrypted artifact; `consume` never needs it because the target repo
# is public (see PLAN.md, decision #8). Avoid pasting a real token here by
# hand, since it then lingers in your terminal scrollback and shell history:
# run `hf auth login` once instead and leave both HF_TOKEN and
# HF_TOKEN_FILE unset, and produce picks up the cached login automatically.
HF_TOKEN=

# Path to a file holding the Hugging Face token, symmetric with
# ENCRYPTION_KEY_FILE and the natural fit for a mounted Kubernetes Secret.
# Takes precedence over HF_TOKEN when both are set. HF_TOKEN and
# HF_TOKEN_FILE both take precedence over a token cached by `hf auth login`.
# e.g. HF_TOKEN_FILE=.hf-token
HF_TOKEN_FILE=

# Base64-encoded AES-256 master key. Exists only for local, file-less
# execution; avoid pasting a key here by hand, since it then lingers in your
# terminal scrollback and shell history. Prefer ENCRYPTION_KEY_FILE, which
# also takes precedence when both are set: pipe `keygen`'s output straight
# to a file instead, e.g. `python -m model_pipeline keygen > .encryption-key`.
ENCRYPTION_KEY=

# Path to a file holding the base64-encoded master key, e.g. a Kubernetes
# Secret mounted at /etc/model-keys/encryption-key, or a local file
# populated directly from `keygen`'s output. The preferred way to supply
# the key, in every environment (see PLAN.md, decision #6).
# e.g. ENCRYPTION_KEY_FILE=.encryption-key
ENCRYPTION_KEY_FILE=

# --- Pipeline configuration ---

# Target Hugging Face repo for the encrypted artifact, e.g.
# <namespace>/bert-tiny-encrypted. Used by `produce` and `list`.
MODEL_REPO_ID=

# Artifact version to publish (`produce`) or fetch (`consume`), e.g. 1.0.0.
MODEL_VERSION=

# Open, source model to encrypt. Defaults to google/bert_uncased_L-2_H-128_A-2
# if unset.
SOURCE_MODEL=google/bert_uncased_L-2_H-128_A-2

# Directory the consumer decrypts the model into. Inside Kubernetes this is
# the tmpfs emptyDir mount at /mnt/model (see k8s/consumer-pod.yaml); for a
# local run, point it at a throwaway directory you create and remove
# yourself (e.g. `mktemp -d`), never a fixed /tmp path -- see
# docs/decisions.md for why.
# e.g. MODEL_WORKDIR=/mnt/model
MODEL_WORKDIR=

# --- Logging ---

# Verbosity of diagnostics written to stderr: debug, info, warning, or
# error. Overridden by --log-level on any subcommand. Raise it to debug to
# see chunk-level crypto detail; the Kubernetes Job/Pod can set this without
# changing any container args. Defaults to info if unset.
LOG_LEVEL=info
